# Optional: deliver contact form submissions by email through Resend (https://resend.com).
# Without these, submissions are validated and logged on the server only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional: send every submission straight to your WhatsApp, automatically, via CallMeBot (free).
# Get the key: save +34 644 66 32 62 in your contacts, send it "I allow callmebot to send me messages"
# on WhatsApp, and it replies with your apikey. Without it, the form opens WhatsApp with the details
# filled in, and the visitor taps Send.
CALLMEBOT_API_KEY=
WHATSAPP_TO_NUMBER=918873867316
